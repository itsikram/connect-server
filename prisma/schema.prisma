// Prisma schema for the MySQL database (connect-db). Replaces the Mongoose models.
//
// Conventions (keep them when adding models):
// - `id` holds the old Mongo ObjectId hex string; config/prisma.js generates new
//   ObjectId-style ids and adds a computed `_id` to every result, so API and
//   socket payloads keep the Mongo shape.
// - Reference columns keep the Mongo field name (`author`, `user`, `userId`) so
//   unpopulated rows look as before. The relation for a populated reference is
//   `<field>Doc`; utils/db.js `populated()` copies it back onto the field name.
// - Arrays of references are join tables named after the Mongo array
//   (`reacts`, `shares`, `followers`, ...). Embedded blobs that are only read
//   with their parent are Json columns.
// - relationMode = "prisma": no database FKs, so migrated Mongo data with
//   dangling references still loads. Every reference column is indexed.

generator client {
  provider      = "prisma-client-js"
  // "native" covers local Windows; the rhel targets cover GoDaddy cPanel (CloudLinux).
  binaryTargets = ["native", "rhel-openssl-1.1.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider     = "mysql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

// ───────────────────────────── Accounts ─────────────────────────────

model User {
  id                      String    @id @default(cuid()) @db.VarChar(32)
  firstName               String    @db.VarChar(191)
  surname                 String    @db.VarChar(191)
  nickname                String?   @db.VarChar(191)
  username                String?   @db.VarChar(191)
  email                   String    @db.VarChar(191)
  password                String?   @db.VarChar(255)
  faceLoginEnabled        Boolean   @default(false)
  googleId                String?   @unique @db.VarChar(191)
  DOB                     String?   @db.VarChar(64)
  gender                  String?   @db.VarChar(64)
  language                String    @default("eng") @db.VarChar(8)
  lastLogin               Float?
  profile                 String?   @db.VarChar(32)
  resetPasswordToken      String?   @db.VarChar(255)
  resetPasswordExpire     DateTime?
  walletBalanceCoins      Int       @default(0)
  creatorEarningsCoins    Int       @default(0)
  payoutReservedCoins     Int       @default(0)
  lastDailyCoinRewardDate String?   @db.VarChar(32)
  subscriptionStatus      String    @default("none") @db.VarChar(32)
  subscriptionTier        String    @default("none") @db.VarChar(32)
  subscriptionExpiresAt   DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  profileDoc     Profile?        @relation("UserProfile", fields: [profile], references: [id], onDelete: NoAction, onUpdate: NoAction)
  profilesOwned  Profile[]       @relation("ProfileUser")
  payoutRequests PayoutRequest[]
  savedVideos    SavedVideo[]
  transactions   Transaction[]

  @@index([email])
  @@index([profile])
  @@map("users")
}

model Admin {
  id                  String    @id @default(cuid()) @db.VarChar(32)
  fullName            String    @db.VarChar(191)
  email               String    @db.VarChar(191)
  password            String    @db.VarChar(255)
  role                String    @default("superAdmin") @db.VarChar(32)
  resetPasswordToken  String?   @db.VarChar(255)
  resetPasswordExpire DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([email])
  @@map("admins")
}

model Profile {
  id                      String    @id @default(cuid()) @db.VarChar(32)
  username                String    @default("") @db.VarChar(64)
  nickname                String    @default("") @db.VarChar(64)
  fullName                String?   @db.VarChar(191)
  displayName             String?   @db.VarChar(191)
  banglaName              String    @default("") @db.VarChar(191)
  coverPic                String?   @db.Text
  profilePic              String?   @db.Text
  bio                     String    @default("Hello World, I am a new User") @db.VarChar(255)
  lastEmotion             String?   @db.VarChar(64)
  lastEmotionText         String?   @db.Text
  lastEmotionEmoji        String?   @db.VarChar(32)
  lastEmotionConfidence   Float?
  lastEmotionQuality      Float?
  /// { latitude, longitude, timestamp, ... }
  lastLocation            Json?
  /// [{ requester, relationTypes: [String] }]
  pendingConnectRelations Json?
  workPlaces              Json?
  schools                 Json?
  presentAddress          String?   @db.Text
  permanentAddress        String?   @db.Text
  settings                Json?
  appMenuOrder            Json?
  isOfficial              Boolean   @default(false)
  isVerified              Boolean   @default(false)
  lastWeeklyRecapAt       DateTime?
  isActive                Boolean   @default(false)
  lastActive              DateTime?
  deviceTokens            Json?
  /// [{ browserId, userAgent, lastActive, isActive }]
  browserIds              Json?
  /// [{ endpoint, keys: { p256dh, auth }, userAgent, browserId, createdAt, lastUsedAt }]
  webPushSubscriptions    Json?
  user                    String?   @db.VarChar(32)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  userDoc User?  @relation("ProfileUser", fields: [user], references: [id], onDelete: NoAction, onUpdate: NoAction)
  userOf  User[] @relation("UserProfile")

  // reference arrays (join tables)
  connects        ProfileConnect[] @relation("ConnectOwner")
  connectedBy     ProfileConnect[] @relation("ConnectTarget")
  connectReqs     ConnectRequest[] @relation("ConnectRequestReceiver")
  sentConnectReqs ConnectRequest[] @relation("ConnectRequestSender")
  following       Follow[]         @relation("Follower")
  followers       Follow[]         @relation("Followed")
  blockedUsers    Block[]          @relation("Blocker")
  blockedBy       Block[]          @relation("Blocked")

  // back-relations
  posts          Post[]        @relation("PostAuthor")
  watches        Watch[]       @relation("WatchAuthor")
  stories        Story[]       @relation("StoryAuthor")
  comments       Comment[]     @relation("CommentAuthor")
  cmntReplies    CmntReply[]   @relation("CmntReplyAuthor")
  postReacts     PostReact[]
  postShares     PostShare[]
  postViews      PostViewer[]
  postMentions   PostMention[]
  watchReacts    WatchReact[]
  watchShares    WatchShare[]
  storyReacts    StoryReact[]
  storySeen      StorySeen[]
  reportsMade    Report[]      @relation("ReportBy")
  reportsAgainst Report[]      @relation("ReportTargetProfile")
  ludoHosted     LudoGame[]    @relation("LudoHost")

  @@index([user])
  @@index([banglaName])
  @@index([isOfficial])
  @@index([isVerified])
  @@index([lastActive])
  @@index([username])
  @@map("profiles")
}

/// Profile.connects — one row per direction, as Mongo stored it on both profiles.
model ProfileConnect {
  id        String   @id @default(cuid()) @db.VarChar(32)
  profile   String   @db.VarChar(32)
  connect   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  profileDoc Profile @relation("ConnectOwner", fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)
  connectDoc Profile @relation("ConnectTarget", fields: [connect], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profile, connect])
  @@index([connect])
  @@map("profile_connects")
}

/// Profile.connectReqs — `profile` received a request from `requester`.
model ConnectRequest {
  id        String   @id @default(cuid()) @db.VarChar(32)
  profile   String   @db.VarChar(32)
  requester String   @db.VarChar(32)
  createdAt DateTime @default(now())

  profileDoc   Profile @relation("ConnectRequestReceiver", fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)
  requesterDoc Profile @relation("ConnectRequestSender", fields: [requester], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profile, requester])
  @@index([requester])
  @@map("connect_requests")
}

/// Profile.following / Profile.followers — `follower` follows `following`.
model Follow {
  id        String   @id @default(cuid()) @db.VarChar(32)
  follower  String   @db.VarChar(32)
  following String   @db.VarChar(32)
  createdAt DateTime @default(now())

  followerDoc  Profile @relation("Follower", fields: [follower], references: [id], onDelete: Cascade, onUpdate: NoAction)
  followingDoc Profile @relation("Followed", fields: [following], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([follower, following])
  @@index([following])
  @@map("follows")
}

/// Profile.blockedUsers
model Block {
  id        String   @id @default(cuid()) @db.VarChar(32)
  profile   String   @db.VarChar(32)
  blocked   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  profileDoc Profile @relation("Blocker", fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)
  blockedDoc Profile @relation("Blocked", fields: [blocked], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([profile, blocked])
  @@index([blocked])
  @@map("blocks")
}

model Relationship {
  id           String   @id @default(cuid()) @db.VarChar(32)
  userA        String   @db.VarChar(32)
  userB        String   @db.VarChar(32)
  relationType String   @db.VarChar(80)
  createdBy    String   @db.VarChar(32)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([userA, userB, relationType])
  @@index([userB])
  @@map("relationships")
}

model Setting {
  id                          String   @id @default(cuid()) @db.VarChar(32)
  username                    String?  @db.VarChar(191)
  nickanme                    String?  @db.VarChar(191)
  isShareEmotion              Boolean  @default(false)
  isShareLocation             Boolean  @default(true)
  showIsTyping                Boolean  @default(true)
  ringtone                    Int      @default(1)
  actionEmoji                 String?  @db.VarChar(64)
  themeMode                   String   @default("dark") @db.VarChar(32)
  language                    String   @default("eng") @db.VarChar(8)
  postVisibility              String   @default("public") @db.VarChar(32)
  connectRequestVisibility    String   @default("public") @db.VarChar(32)
  timelinePostVisibility      String   @default("public") @db.VarChar(32)
  connectRequestReceived      Boolean  @default(true)
  connectRequestAccepted      Boolean  @default(true)
  newMessageReceived          Boolean  @default(true)
  newConnectPost              Boolean  @default(true)
  newConnectStory             Boolean  @default(true)
  newConnectWatch             Boolean  @default(true)
  connectRequestReceivedEmail Boolean  @default(false)
  connectRequestAcceptedEmail Boolean  @default(false)
  newMessageReceivedEmail     Boolean  @default(false)
  newConnectPostEmail         Boolean  @default(false)
  newConnectStoryEmail        Boolean  @default(false)
  newConnectWatchEmail        Boolean  @default(false)
  chatBackground              String?  @db.Text
  connectChatSettings         Json?
  profile                     String?  @db.VarChar(32)
  createdAt                   DateTime @default(now())
  updatedAt                   DateTime @updatedAt

  @@index([profile])
  @@map("settings")
}

model FaceEncoding {
  id           String   @id @default(cuid()) @db.VarChar(32)
  name         String   @db.VarChar(191)
  email        String?  @unique @db.VarChar(191)
  /// 128 floats
  faceEncoding Json
  profile      String?  @db.VarChar(32)
  timestamp    DateTime @default(now())

  @@index([profile])
  @@map("faceencodings")
}

// ───────────────────────────── Social content ─────────────────────────────

model Post {
  id                   String    @id @default(cuid()) @db.VarChar(32)
  caption              String?   @db.Text
  hashtags             Json?
  photos               String?   @db.Text
  gallery              Json?
  audience             Int       @default(3)
  author               String?   @db.VarChar(32)
  /// Shared post id (the Mongo schema said ref Profile, but it holds a Post id).
  parentPost           String?   @db.VarChar(32)
  faceExpression       String?   @db.VarChar(64)
  location             String?   @db.Text
  feelings             String?   @db.VarChar(191)
  type                 String    @default("post") @db.VarChar(32)
  source               String    @default("user") @db.VarChar(32)
  // aiMetadata.* flattened so status / contentHash can be indexed
  aiStatus             String    @default("pending") @db.VarChar(16)
  aiCategories         Json?
  aiEmbedding          Json?
  aiEmbeddingModel     String?   @db.VarChar(128)
  aiProvider           String?   @db.VarChar(64)
  aiContentHash        String?   @db.VarChar(128)
  aiSentiment          String?   @db.VarChar(64)
  aiContentSafetyFlags Json?
  aiProcessedAt        DateTime?
  aiError              String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  authorDoc     Profile?      @relation("PostAuthor", fields: [author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentPostDoc Post?         @relation("PostShareOf", fields: [parentPost], references: [id], onDelete: NoAction, onUpdate: NoAction)
  sharedAs      Post[]        @relation("PostShareOf")
  mentions      PostMention[]
  reacts        PostReact[]
  comments      Comment[]     @relation("PostComments")
  shares        PostShare[]
  viewers       PostViewer[]
  reports       Report[]      @relation("ReportTargetPost")

  @@index([author, createdAt])
  @@index([parentPost])
  @@index([aiStatus])
  @@index([aiContentHash])
  @@index([createdAt])
  @@map("posts")
}

model PostMention {
  id        String   @id @default(cuid()) @db.VarChar(32)
  post      String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  postDoc    Post    @relation(fields: [post], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post, profile])
  @@index([profile])
  @@map("post_mentions")
}

/// Post.reacts — { profile, type }
model PostReact {
  id        String   @id @default(cuid()) @db.VarChar(32)
  post      String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  type      String?  @db.VarChar(32)
  createdAt DateTime @default(now())

  postDoc    Post    @relation(fields: [post], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post, profile])
  @@index([profile])
  @@map("post_reacts")
}

model PostShare {
  id        String   @id @default(cuid()) @db.VarChar(32)
  post      String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  postDoc    Post    @relation(fields: [post], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([post])
  @@index([profile])
  @@map("post_shares")
}

model PostViewer {
  id        String   @id @default(cuid()) @db.VarChar(32)
  post      String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  postDoc    Post    @relation(fields: [post], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([post, profile])
  @@index([profile])
  @@map("post_viewers")
}

model Watch {
  id                   String    @id @default(cuid()) @db.VarChar(32)
  caption              String?   @db.Text
  thumbnail            String?   @db.Text
  videoUrl             String?   @db.Text
  youtubeId            String?   @db.VarChar(64)
  feeling              String?   @db.VarChar(191)
  audience             Int       @default(3)
  author               String?   @db.VarChar(32)
  type                 String    @default("watch") @db.VarChar(32)
  aiStatus             String    @default("pending") @db.VarChar(16)
  aiCategories         Json?
  aiEmbedding          Json?
  aiEmbeddingModel     String?   @db.VarChar(128)
  aiProvider           String?   @db.VarChar(64)
  aiContentHash        String?   @db.VarChar(128)
  aiSentiment          String?   @db.VarChar(64)
  aiContentSafetyFlags Json?
  aiProcessedAt        DateTime?
  aiError              String?   @db.Text
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  authorDoc Profile?     @relation("WatchAuthor", fields: [author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reacts    WatchReact[]
  comments  Comment[]    @relation("WatchComments")
  shares    WatchShare[]

  @@index([author, createdAt])
  @@index([youtubeId])
  @@index([aiStatus])
  @@index([aiContentHash])
  @@index([createdAt])
  @@map("watches")
}

model WatchReact {
  id        String   @id @default(cuid()) @db.VarChar(32)
  watch     String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  type      String?  @db.VarChar(32)
  createdAt DateTime @default(now())

  watchDoc   Watch   @relation(fields: [watch], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([watch, profile])
  @@index([profile])
  @@map("watch_reacts")
}

model WatchShare {
  id        String   @id @default(cuid()) @db.VarChar(32)
  watch     String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  watchDoc   Watch   @relation(fields: [watch], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([watch])
  @@index([profile])
  @@map("watch_shares")
}

model Story {
  id        String   @id @default(cuid()) @db.VarChar(32)
  image     String?  @db.Text
  music     String?  @db.Text
  bgColor   String?  @db.VarChar(64)
  audience  Int      @default(3)
  author    String?  @db.VarChar(32)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  authorDoc Profile?     @relation("StoryAuthor", fields: [author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reacts    StoryReact[]
  seenBy    StorySeen[]
  comments  Comment[]    @relation("StoryComments")

  @@index([author, createdAt])
  @@index([createdAt])
  @@map("stories")
}

model StoryReact {
  id        String   @id @default(cuid()) @db.VarChar(32)
  story     String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  type      String?  @db.VarChar(32)
  createdAt DateTime @default(now())

  storyDoc   Story   @relation(fields: [story], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([story, profile])
  @@index([profile])
  @@map("story_reacts")
}

model StorySeen {
  id        String   @id @default(cuid()) @db.VarChar(32)
  story     String   @db.VarChar(32)
  profile   String   @db.VarChar(32)
  createdAt DateTime @default(now())

  storyDoc   Story   @relation(fields: [story], references: [id], onDelete: Cascade, onUpdate: NoAction)
  profileDoc Profile @relation(fields: [profile], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([story, profile])
  @@index([profile])
  @@map("story_seen")
}

/// A comment belongs to one of post / watch / story (Mongo kept the id in the
/// parent's `comments` array; here the comment points at its parent).
model Comment {
  id         String   @id @default(cuid()) @db.VarChar(32)
  body       String?  @db.Text
  attachment String?  @db.Text
  author     String?  @db.VarChar(32)
  post       String?  @db.VarChar(32)
  watch      String?  @db.VarChar(32)
  story      String?  @db.VarChar(32)
  reacts     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorDoc Profile?    @relation("CommentAuthor", fields: [author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  postDoc   Post?       @relation("PostComments", fields: [post], references: [id], onDelete: NoAction, onUpdate: NoAction)
  watchDoc  Watch?      @relation("WatchComments", fields: [watch], references: [id], onDelete: NoAction, onUpdate: NoAction)
  storyDoc  Story?      @relation("StoryComments", fields: [story], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   CmntReply[]

  @@index([author])
  @@index([post, createdAt])
  @@index([watch, createdAt])
  @@index([story, createdAt])
  @@map("comments")
}

model CmntReply {
  id         String   @id @default(cuid()) @db.VarChar(32)
  body       String?  @db.Text
  attachment String?  @db.Text
  author     String?  @db.VarChar(32)
  post       String?  @db.VarChar(32)
  parent     String   @db.VarChar(32)
  reacts     Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  authorDoc Profile? @relation("CmntReplyAuthor", fields: [author], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parentDoc Comment  @relation(fields: [parent], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([author])
  @@index([parent, createdAt])
  @@index([post])
  @@map("cmntreplies")
}

model Report {
  id            String   @id @default(cuid()) @db.VarChar(32)
  type          String   @db.VarChar(16)
  targetPost    String?  @db.VarChar(32)
  targetProfile String?  @db.VarChar(32)
  reportedBy    String   @db.VarChar(32)
  reason        String   @db.VarChar(80)
  details       String?  @db.Text
  status        String   @default("open") @db.VarChar(16)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  targetPostDoc    Post?    @relation("ReportTargetPost", fields: [targetPost], references: [id], onDelete: NoAction, onUpdate: NoAction)
  targetProfileDoc Profile? @relation("ReportTargetProfile", fields: [targetProfile], references: [id], onDelete: NoAction, onUpdate: NoAction)
  reportedByDoc    Profile  @relation("ReportBy", fields: [reportedBy], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([type, targetPost, reportedBy, status])
  @@index([type, targetProfile, reportedBy, status])
  @@index([targetPost])
  @@index([targetProfile])
  @@index([reportedBy])
  @@map("reports")
}

// ───────────────────────────── Messaging & notifications ─────────────────────────────

model Message {
  id                               String    @id @default(cuid()) @db.VarChar(32)
  room                             String?   @db.VarChar(191)
  senderId                         String?   @db.VarChar(64)
  receiverId                       String?   @db.VarChar(64)
  message                          String?   @db.Text
  messageType                      String    @default("text") @db.VarChar(16)
  duration                         Float?
  callType                         String?   @db.VarChar(16)
  callEvent                        String?   @db.VarChar(16)
  parent                           String?   @db.VarChar(32)
  attachment                       String?   @db.Text
  reacts                           Json?
  tempId                           String?   @db.VarChar(191)
  isSeen                           Boolean   @default(false)
  unseenReminderEmailSentAt        DateTime?
  unseenReminderEmailProcessingKey String?   @db.VarChar(191)
  unseenReminderEmailProcessingAt  DateTime?
  unseenReminderEmailLastError     String?   @db.Text
  timestamp                        DateTime  @default(now())

  parentDoc Message?  @relation("MessageReply", fields: [parent], references: [id], onDelete: NoAction, onUpdate: NoAction)
  replies   Message[] @relation("MessageReply")

  @@index([senderId, receiverId, timestamp])
  @@index([receiverId, timestamp])
  @@index([senderId, timestamp])
  @@index([receiverId, isSeen, timestamp])
  @@index([senderId, tempId])
  @@index([isSeen, messageType, unseenReminderEmailSentAt, unseenReminderEmailProcessingAt])
  @@index([parent])
  @@map("messages")
}

model Notification {
  id         String   @id @default(cuid()) @db.VarChar(32)
  receiverId String?  @db.VarChar(32)
  text       String?  @db.Text
  title      String?  @db.Text
  icon       String?  @db.Text
  link       String?  @db.Text
  type       String?  @db.VarChar(64)
  data       Json?
  reacts     Json?
  isSeen     Boolean  @default(false)
  timestamp  DateTime @default(now())

  @@index([receiverId, isSeen, timestamp])
  @@index([receiverId, timestamp])
  @@map("notifications")
}

// ───────────────────────────── AI ─────────────────────────────

model AIChat {
  id               String   @id @default(cuid()) @db.VarChar(32)
  user             String   @unique @db.VarChar(32)
  messages         Json?
  sessionTimestamp DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@map("aichats")
}

model AIGeneratedPost {
  id              String    @id @default(cuid()) @db.VarChar(32)
  author          String    @db.VarChar(32)
  post            String?   @db.VarChar(32)
  category        String    @db.VarChar(191)
