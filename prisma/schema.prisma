// ───────────────────────────── Monetization ─────────────────────────────

model Transaction {
  id                String    @id @default(cuid()) @db.VarChar(32)
  userId            String    @db.VarChar(32)
  type              String    @db.VarChar(32)
  subscriptionTier  String?   @db.VarChar(32)
  coachingPlanId    String?   @db.VarChar(64)
