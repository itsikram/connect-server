# ============================================================
# Database Configuration
# ============================================================
NODE_ENV=development
DEV_MONGODB_URI=mongodb://localhost:27017/connect
PROD_MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/connect

# ============================================================
# Server Configuration
# ============================================================
PORT=4000
FACE_SERVICE_URL=http://localhost:5001

# ============================================================
# CPU load balancer (npm run start:lb / Docker / Render)
# Public traffic hits PORT (Render injects this). API workers bind 4001+.
# ============================================================
# LB_PORT=4000
# LB_BACKENDS=2
# LB_BACKEND_START_PORT=4001
# BACKEND_SERVERS=http://127.0.0.1:4001,http://127.0.0.1:4002
# PEER_SERVERS=http://127.0.0.1:4001,http://127.0.0.1:4002
# INSTANCE_URL=http://127.0.0.1:4001
# RUN_WORKERS=1
# LB_INTERNAL_SECRET=change-me-in-production
# LB_POLL_MS=1500

# ============================================================
# Email (SMTP only)
# ============================================================
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
# Render and other IPv6-limited hosts should resolve SMTP over IPv4.
SMTP_FORCE_IPV4=true
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Connect
# Optional: portfolio contact form recipient (defaults to SMTP_FROM)
# SMTP_TO=owner@example.com

# Email Timeouts (milliseconds)
SMTP_CONNECTION_TIMEOUT=20000
SMTP_GREETING_TIMEOUT=15000
SMTP_SOCKET_TIMEOUT=30000

# ============================================================
# Unseen Message Reminder Worker Configuration
# ============================================================

# Delay before sending reminder email (milliseconds)
# Default: 300000 (5 minutes)
# Set to 10000 (10 seconds) for testing
UNSEEN_MESSAGE_REMINDER_DELAY_MS=300000

# How often the worker runs to check for unseen messages (milliseconds)
# Default: 60000 (1 minute)
# Set to 5000 (5 seconds) for testing
UNSEEN_MESSAGE_REMINDER_INTERVAL_MS=60000

# Time before a processing lock is considered stale and can be reclaimed (milliseconds)
# Default: 600000 (10 minutes)
UNSEEN_MESSAGE_REMINDER_STALE_LOCK_MS=600000

# Maximum number of sender-receiver message groups to process per run
# Default: 20
# Increase if you have many concurrent conversations
UNSEEN_MESSAGE_REMINDER_MAX_GROUPS_PER_RUN=20

# Disable the unseen message reminder worker completely
# Default: false
DISABLE_UNSEEN_MESSAGE_REMINDERS=false

# ============================================================
# Client/Frontend URL
# ============================================================
# Used in reminder emails to link back to the chat
CLIENT_URL=http://localhost:3000
# Alternative configurations (pick one):
# REACT_APP_URL=http://localhost:3000
# FRONTEND_URL=http://localhost:3000

# ============================================================
# Firebase Admin SDK Configuration
# ============================================================
# Option 1: Service Account JSON (minified on one line)
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"..."}

# Option 2: Base64 encoded service account
# FIREBASE_SERVICE_ACCOUNT_BASE64=eyJ0eXBlIjoic2VydmljZV9hY2NvdW50IiwicHJvamVjdF9pZCI6I...

# Option 3: Path to service account file
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKeys.json

# Option 4: Split environment variables
FIREBASE_TYPE=service_account
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_PRIVATE_KEY_ID=your-key-id
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your-client-id
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=https://www.googleapis.com/robot/v1/metadata/x509/firebase-adminsdk-xxxxx%40your-project-id.iam.gserviceaccount.com
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# ============================================================
# Cloudinary (File Storage)
# ============================================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# ============================================================
# JWT & Authentication
# ============================================================
JWT_SECRET=your-jwt-secret-key-change-in-production

# ============================================================
# Optional AI fallbacks (prefer Connect Admin → Settings → AI)
# ============================================================
# GEMINI_API_KEY=
# OPENAI_API_KEY=
# CURSOR_API_KEY=
# CURSOR_REPO_URL=

# ============================================================
# YouTube Data API v3 (search on /yt-download)
# ============================================================
# Enable "YouTube Data API v3" and create a key at:
# https://console.cloud.google.com/apis/credentials
# YOUTUBE_API_KEY=

# ============================================================
# Home PC Cobalt sync (live tunnel URL updates)
# ============================================================
# Required when the local home-cobalt worker calls the live Connect server.
# COBALT_SYNC_SECRET=replace-with-a-long-random-secret

# ============================================================
# Other Services
# ============================================================
# Add other third-party service keys as needed
